#define RT_MANIFEST 24
#define VOS_NT_WINDOWS32 0x00040004
#define VFT_APP 1
#include "../src/version.h"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION CLEAN_FILE_VERSION
PRODUCTVERSION CLEAN_PRODUCT_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "PL80E Open Source Driver Setup\0"
   VALUE "FileVersion", CLEAN_VERSION_TEXT "\0"
   VALUE "ProductName", "PL80E Open Source Driver\0"
   VALUE "ProductVersion", CLEAN_VERSION_TEXT "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
